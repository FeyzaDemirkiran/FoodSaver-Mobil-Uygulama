<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/kayitolgirisyap"
    android:gravity="center_horizontal"
    android:padding="24dp"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="240dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/caprilo"
        android:gravity="center"
        android:text="FoodSaver’a Hoş Geldiniz"
        android:textColor="#D5749A"
        android:textSize="36sp"
        android:textStyle="bold" />


    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <Button
            android:id="@+id/btn_giris"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giriş Yap"
            app:backgroundTint="#D5749A"
            android:layout_marginTop="-100dp"/>

        <View
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_kayit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kayıt Ol"
            app:backgroundTint="#D5749A"
            android:layout_marginTop="-100dp"/>
    </LinearLayout>

</LinearLayout>