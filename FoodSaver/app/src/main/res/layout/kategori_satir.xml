<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:foreground="?attr/selectableItemBackground"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="6dp"
    card_view:cardBackgroundColor="@android:color/transparent"> <!-- 🔧 Bu satır değiştirildi -->

    <LinearLayout
        android:id="@+id/kategoriArkaPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">
        <!-- 🔧 backgroundTint satırı kaldırıldı -->

        <ImageView
            android:id="@+id/kategoriResmi"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:scaleType="centerCrop"
            android:padding="4dp"
            android:contentDescription="Kategori Görseli" />

        <TextView
            android:id="@+id/kategoriAdi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kategori Adı"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</androidx.cardview.widget.CardView>